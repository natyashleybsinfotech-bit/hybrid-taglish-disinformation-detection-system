{
  "manifest_version": 3,
  "name": "SuriPH",
  "version": "1.1.1",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://*.facebook.com/*",
    "*://*.fbcdn.net/*",
    "*://*.fbsbx.com/*",
    "*://*.x.com/*",
    "*://*.twimg.com/*",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.reddit.com/*",
    "*://*.redd.it/*"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*", 
        "*://*.x.com/*", 
        "*://*.twitter.com/*",
        "*://*.reddit.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["src/content.js"]
    }
  ]
}
