{
  "manifest_version": 3,
  "name": "SuriPH",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://*.facebook.com/*",
    "*://*.fbcdn.net/*",
    "*://*.fbsbx.com/*",
    "*://*.x.com/*",
    "*://*.twimg.com/*",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.reddit.com/*",
    "*://*.redd.it/*"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.js-D9nbVGSO.js"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.reddit.com/*",
        "*://*.youtube.com/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.reddit.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.youtube.com/*"
      ],
      "resources": [
        "assets/content.js-D9nbVGSO.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
